∃ A,
  NonCalkinAlgebra.HasDensityCharacter A.Carrier Cardinal.continuum ∧
    NonCalkinAlgebra.HasExactlyOneNonzeroProperClosedIdeal A.Carrier ∧
      ∀ (convention : NonCalkinAlgebra.QuotientConvention) (X : Type v) [inst : NormedAddCommGroup X]
        [inst_1 : NormedSpace ℂ X] [CompleteSpace X],
        ¬Nonempty (NonCalkinAlgebra.OperatorQuotientIso X convention A.Carrier)
