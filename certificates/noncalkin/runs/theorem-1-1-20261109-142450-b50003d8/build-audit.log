theorem NonCalkinAlgebra.main_from_prerequisites.{v} : NonCalkinAlgebra.CoefficientExistenceStatement →
  NonCalkinAlgebra.IdempotentLiftingStatement → NonCalkinAlgebra.MainStatement :=
fun hCoefficient hLift =>
  Exists.casesOn hCoefficient fun D h =>
    And.casesOn h fun hDnorm right =>
      And.casesOn right fun hDdensity right =>
        And.casesOn right fun hDsimple hDavoid =>
          Exists.intro (NonCalkinAlgebra.matrixBanachAlgebra D.Carrier)
            ⟨NonCalkinAlgebra.matrixAlgebra_density_continuum D.Carrier hDdensity,
              ⟨NonCalkinAlgebra.matrixAlgebra_has_exactly_one_ideal D.Carrier hDsimple,
                fun convention X [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X] =>
                NonCalkinAlgebra.matrixAlgebra_not_representable_from_prerequisites D.Carrier hLift hDsimple convention
                  (hDavoid convention) X⟩⟩
