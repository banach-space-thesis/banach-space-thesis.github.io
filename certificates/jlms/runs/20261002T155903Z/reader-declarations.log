{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_neighborhood_arbitrarily_late_small_weight","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {K : Type u_2} [inst_1 : TopologicalSpace K] [LocallyCompactSpace K] [T2Space K],\n  JLMS.IsScattered K →\n    ∀ (f : ℕ → ↥(JLMS.ellOneOn 𝕜 K)) (F : ℕ → Finset K),\n      (Pairwise fun i j => Disjoint (F i) (F j)) →\n        ∀ (M : ℝ),\n          (∀ (j : ℕ), ‖f j‖ ≤ M) →\n            ∀ {ε : ℝ}, 0 < ε → ∃ n U, ∀ (J : ℕ), ∃ j, J < j ∧ ‖(JLMS.restrictionL1 (⋃ k, U.sets k)) (f j)‖ < ε"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_neighborhood_subsequence_small_dual_weight","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {K : Type u_2} [inst_1 : TopologicalSpace K] {X : Type u_3}\n  [inst_2 : NormedAddCommGroup X] [inst_3 : NormedSpace 𝕜 X] (M : JLMS.AtomicDualModel 𝕜 K) (T : JLMS.CZero 𝕜 K →L[𝕜] X)\n  [LocallyCompactSpace K] [T2Space K],\n  JLMS.IsScattered K →\n    ∀ (φ : ℕ → X →L[𝕜] 𝕜),\n      (∀ (j : ℕ), ‖φ j‖ ≤ 1) →\n        ∀ (F : ℕ → Finset K),\n          (Pairwise fun i j => Disjoint (F i) (F j)) →\n            ∀ {ε : ℝ},\n              0 < ε →\n                ∃ n U s,\n                  StrictMono s ∧\n                    ∀ (j : ℕ), ‖(JLMS.atomicRestriction M (⋃ k, U.sets k)) ((JLMS.banachAdjoint T) (φ (s j)))‖ < ε"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_neighborhood_subsequence_small_weight","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {K : Type u_2} [inst_1 : TopologicalSpace K] [LocallyCompactSpace K] [T2Space K],\n  JLMS.IsScattered K →\n    ∀ (f : ℕ → ↥(JLMS.ellOneOn 𝕜 K)) (F : ℕ → Finset K),\n      (Pairwise fun i j => Disjoint (F i) (F j)) →\n        ∀ (M : ℝ),\n          (∀ (j : ℕ), ‖f j‖ ≤ M) →\n            ∀ {ε : ℝ}, 0 < ε → ∃ n U s, StrictMono s ∧ ∀ (j : ℕ), ‖(JLMS.restrictionL1 (⋃ k, U.sets k)) (f (s j))‖ < ε"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_normalizedBlock_pointwise_null","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {X : Type u_2} [inst_1 : NormedAddCommGroup X] [inst_2 : NormedSpace 𝕜 X]\n  [CompleteSpace X],\n  ¬JLMS.ContainsEllOne 𝕜 X →\n    ∀ (f : ℕ → X →L[𝕜] 𝕜) {C : ℝ},\n      0 ≤ C →\n        (∀ (n : ℕ), ‖f n‖ ≤ C) → ∃ d, ∀ (x : X), Filter.Tendsto (fun n => (d.applyDual f n) x) Filter.atTop (nhds 0)"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_separated_atomic_pieces","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {K : Type u_2} [inst_1 : TopologicalSpace K] [LocallyCompactSpace K] [T2Space K]\n  {E : Type u_3} [inst_4 : NormedAddCommGroup E] [inst_5 : NormedSpace 𝕜 E],\n  JLMS.IsScattered K →\n    ∀ (L : E →L[𝕜] ↥(JLMS.ellOneOn 𝕜 K)) (r θ : ℝ),\n      0 < θ →\n        ∀ (x : ℕ → E) (A : ℕ → Finset K),\n          (∀ (j : ℕ), ‖x j‖ ≤ 1) →\n            (∀ (j : ℕ), ↑(A j) ⊆ Function.support ↑(L (x j))) →\n              (Pairwise fun i j => Disjoint (A i) (A j)) →\n                (∀ (j : ℕ), r + θ < ‖(JLMS.restrictionL1 ↑(A j)) (L (x j))‖) →\n                  ∃ y B U,\n                    (∀ (j : ℕ), ‖y j‖ ≤ 1) ∧\n                      (∀ (j : ℕ), ↑(B j) ⊆ Function.support ↑(L (y j))) ∧\n                        (Pairwise fun i j => Disjoint (⋃ k, (U i).sets k) (⋃ k, (U j).sets k)) ∧\n                          ∀ (j : ℕ), r < ‖(JLMS.restrictionL1 ↑(B j)) (L (y j))‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_summable_factor_maps","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {E : Type u_2} [inst_1 : NormedAddCommGroup E] [inst_2 : NormedSpace 𝕜 E]\n  [CompleteSpace E],\n  JLMS.FactorTwoFactorizations 𝕜 E →\n    ∀ (ρ : ℕ → ℝ),\n      (∀ (j : ℕ), 0 < ρ j) →\n        Summable ρ →\n          ∀ (T : ℕ → E →L[𝕜] E),\n            (∀ (j : ℕ), 2 / ρ j ^ 2 < JLMS.essentialNorm (T j)) →\n              ∃ U V,\n                (∀ (j : ℕ), ((U j).comp (T j)).comp (V j) = ContinuousLinearMap.id 𝕜 (JLMS.cZero 𝕜)) ∧\n                  (Summable fun j => ‖U j‖) ∧ Summable fun j => ‖V j‖"}
