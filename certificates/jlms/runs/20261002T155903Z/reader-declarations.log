{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_cZero_retract","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {K : Type u_2} [inst_1 : TopologicalSpace K] [LocallyCompactSpace K] [T2Space K]\n  [Infinite K], JLMS.IsScattered K → ∃ A B, B.comp A = ContinuousLinearMap.id 𝕜 (JLMS.cZero 𝕜) ∧ ‖A‖ = 1 ∧ ‖B‖ = 1"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_disjoint_large_dual_atoms","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {K : Type u_2} [inst_1 : TopologicalSpace K] {X : Type u_3}\n  [inst_2 : NormedAddCommGroup X] [inst_3 : NormedSpace 𝕜 X] (M : JLMS.AtomicDualModel 𝕜 K) (T : JLMS.CZero 𝕜 K →L[𝕜] X)\n  {r : ℝ},\n  0 ≤ r →\n    r < JLMS.dualEssentialNorm T →\n      ∃ φ A,\n        (∀ (j : ℕ), ‖φ j‖ ≤ 1) ∧\n          (∀ (j : ℕ), ↑(A j) ⊆ Function.support ↑(M.representation ((JLMS.banachAdjoint T) (φ j)))) ∧\n            (Pairwise fun i j => Disjoint (A i) (A j)) ∧\n              ∀ (j : ℕ), r < ‖(JLMS.atomicRestriction M ↑(A j)) ((JLMS.banachAdjoint T) (φ j))‖"}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"JLMS.exists_disjoint_large_dual_atoms_of_primal","type":"∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {K : Type u_2} [inst_1 : TopologicalSpace K] [LocallyCompactSpace K] [T2Space K]\n  {X : Type u_3} [inst_4 : NormedAddCommGroup X] [inst_5 : NormedSpace 𝕜 X] (M : JLMS.AtomicDualModel 𝕜 K),\n  JLMS.IsScattered K →\n    ∀ (T : JLMS.CZero 𝕜 K →L[𝕜] X) {r : ℝ},\n      0 ≤ r →\n        2 * r < JLMS.essentialNorm T →\n          ∃ φ A,\n            (∀ (j : ℕ), ‖φ j‖ ≤ 1) ∧\n              (∀ (j : ℕ), ↑(A j) ⊆ Function.support ↑(M.representation ((JLMS.banachAdjoint T) (φ j)))) ∧\n                (Pairwise fun i j => Disjoint (A i) (A j)) ∧\n                  ∀ (j : ℕ), r < ‖(JLMS.atomicRestriction M ↑(A j)) ((JLMS.banachAdjoint T) (φ j))‖"}
