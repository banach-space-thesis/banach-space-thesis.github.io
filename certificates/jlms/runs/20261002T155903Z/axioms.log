JLMS.exists_separated_atomic_pieces.{u_1, u_2, u_3} {𝕜 : Type u_1} [RCLike 𝕜] {K : Type u_2} [TopologicalSpace K]
  [LocallyCompactSpace K] [T2Space K] {E : Type u_3} [NormedAddCommGroup E] [NormedSpace 𝕜 E] (hK : JLMS.IsScattered K)
  (L : E →L[𝕜] ↥(JLMS.ellOneOn 𝕜 K)) (r θ : ℝ) (hθ : 0 < θ) (x : ℕ → E) (A : ℕ → Finset K) (hx : ∀ (j : ℕ), ‖x j‖ ≤ 1)
  (hsupport : ∀ (j : ℕ), ↑(A j) ⊆ Function.support ↑(L (x j))) (hA : Pairwise fun i j => Disjoint (A i) (A j))
  (hlarge : ∀ (j : ℕ), r + θ < ‖(JLMS.restrictionL1 ↑(A j)) (L (x j))‖) :
  ∃ y B U,
    (∀ (j : ℕ), ‖y j‖ ≤ 1) ∧
      (∀ (j : ℕ), ↑(B j) ⊆ Function.support ↑(L (y j))) ∧
        (Pairwise fun i j => Disjoint (⋃ k, (U i).sets k) (⋃ k, (U j).sets k)) ∧
          ∀ (j : ℕ), r < ‖(JLMS.restrictionL1 ↑(B j)) (L (y j))‖
