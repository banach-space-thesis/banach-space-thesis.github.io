def BanachIsometric.ComplexFunctionalStatement.{u} : {X : Type u} → [inst : AddCommGroup X] → [Module ℂ X] → Prop :=
fun {X} [AddCommGroup X] [Module ℂ X] =>
  ∀ (n : ℕ) (p : X → ℝ),
    2 ≤ n →
      ↑n < Module.rank ℂ X →
        BanachIsometric.IsDefiniteComplexHomogeneous p →
          BanachIsometric.ComplexSphereLipschitz n p →
            BanachIsometric.RealEquivalentSections n p → BanachIsometric.HasHermitianSquare p
def BanachIsometric.Quaternionic.FunctionalStatement.{u_1} : {E : Type u_1} →
  [inst : AddCommGroup E] → [Module BanachIsometric.Quaternionic.Hᵐᵒᵖ E] → Prop :=
fun {E} [AddCommGroup E] [Module BanachIsometric.Quaternionic.Hᵐᵒᵖ E] =>
  ∀ (n : ℕ) (p : E → ℝ),
    2 ≤ n →
      ↑n < Module.rank BanachIsometric.Quaternionic.Hᵐᵒᵖ E →
        BanachIsometric.Quaternionic.IsDefiniteHomogeneous p →
          BanachIsometric.Quaternionic.SphereLipschitz n p →
            BanachIsometric.Quaternionic.RealEquivalentSections n p → BanachIsometric.Quaternionic.HasHermitianSquare p
def BanachIsometric.MetricSubspaceHomogeneity.{u, u_1} : (𝕜 : Type u_1) →
  [inst : RCLike 𝕜] → (X : Type u) → [inst_1 : NormedAddCommGroup X] → [NormedSpace 𝕜 X] → ℕ → Prop :=
fun 𝕜 [RCLike 𝕜] X [NormedAddCommGroup X] [NormedSpace 𝕜 X] n =>
  ∀ (E F : Submodule 𝕜 X), Module.rank 𝕜 ↥E = ↑n → Module.rank 𝕜 ↥F = ↑n → Nonempty (↥E ≃ᵢ ↥F)
def BanachIsometric.Quaternionic.MetricSubspaceHomogeneity.{u_2} : {V : Type u_2} →
  [inst : NormedAddCommGroup V] → [Module BanachIsometric.Quaternionic.Hᵐᵒᵖ V] → ℕ → Prop :=
fun {V} [NormedAddCommGroup V] [Module BanachIsometric.Quaternionic.Hᵐᵒᵖ V] n =>
  ∀ (Y Z : Submodule BanachIsometric.Quaternionic.Hᵐᵒᵖ V),
    Module.rank BanachIsometric.Quaternionic.Hᵐᵒᵖ ↥Y = ↑n →
      Module.rank BanachIsometric.Quaternionic.Hᵐᵒᵖ ↥Z = ↑n → Nonempty (↥Y ≃ᵢ ↥Z)
def BanachIsometric.ComplexCorollaryBAt.{u} : (X : Type u) →
